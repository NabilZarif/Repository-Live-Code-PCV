import cv2

# === 1. IMPORT FOTO ===
# Ganti 'gambar.jpg' dengan nama file fotomu yang sebenarnya.
# Pastikan fotonya ada di folder yang sama dengan file Python ini.
img = cv2.imread('gambar.jpg') 

if img is None:
    print("Error: Gambar tidak ditemukan! Cek kembali nama dan lokasi file.")
else:
    # Pisahkan warna (OpenCV menggunakan format B-G-R)
    blue_channel, green_channel, red_channel = cv2.split(img)

    # Konversi gambar asli ke mode Grayscale
    gray_img = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

    # === 2. SAVE HASIL EKSTRAK ===
    # Format: cv2.imwrite('nama_file_tujuan.ekstensi', variabel_gambar)
    
    cv2.imwrite('hasil_channel_merah.jpg', red_channel)
    cv2.imwrite('hasil_channel_hijau.jpg', green_channel)
    cv2.imwrite('hasil_channel_biru.jpg', blue_channel)
    cv2.imwrite('hasil_grayscale.jpg', gray_img)

    print("Berhasil! Semua file gambar hasil ekstraksi telah disimpan di folder ini.")